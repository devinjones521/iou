# Copy to .env and fill in. Never commit .env or the .pem — both are gitignored.

# ── The model backend. A provider chain: the first one set wins. ─────────────────────────────
# Set ONE of these. Without either, the bot falls back to shelling out to the Claude Code CLI,
# which runs on your own interactive login — fine locally, not deployable, and ~23x the cost
# per call because the CLI injects ~22k tokens of scaffolding into every request.
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPTIONAL, OpenRouter only. Defaults to anthropic/claude-opus-4.5.
# IOU_OPENROUTER_MODEL=

# The GitHub App that gives the bot its own identity, so comments come from <slug>[bot]
# rather than from a person. Create at https://github.com/settings/apps/new with:
#   Webhook: OFF
#   Repository permissions: Contents read, Issues write, Pull requests write
#   Install on the one repository you want it to watch.
IOU_APP_ID=
IOU_INSTALLATION_ID=
IOU_APP_PEM=./iou-app.pem
IOU_BOT_LOGIN=your-app-slug[bot]

# The repository IOU watches.
IOU_REPO=owner/repo

# Optional. Seconds between polls (default 15).
IOU_INTERVAL_S=15

# Optional. Model for the bot's own classification and diff-judgement calls.
# Must be a full API model id. The bare aliases "opus" / "haiku" are Claude Code CLI names and
# return 404 not_found_error from the API — and because the bot fails closed, that 404 looks
# exactly like the bot deciding to stay quiet. Leave this unset unless you mean to change it.
IOU_MODEL=claude-opus-5

# Optional, CLI fallback only (ignored when an API key is set). Accepts CLI aliases like "opus".
# IOU_CLI_MODEL=opus

# ── Spend ceilings. All three fail closed; a value that isn't a number falls back to the ─────
# default rather than removing the ceiling. Defaults shown.
# IOU_MAX_CALLS_PER_ACTOR_HOUR=40
# IOU_MAX_CALLS_PER_TICK=20
# IOU_MAX_CALLS_TOTAL=2000

# Only needed by scripts/record.mjs (demo staging). The ssh alias of your deployment host.
# IOU_SSH_HOST=
